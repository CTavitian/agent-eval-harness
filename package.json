{
  "name": "agent-eval-harness",
  "version": "1.0.0",
  "private": false,
  "description": "CLI to run YAML agent eval suites with mock or live adapters",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-eval": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "eval": "tsx src/cli/index.ts",
    "eval:sample": "tsx src/cli/index.ts --suite suites/ops-triage.yaml --adapter mock",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
